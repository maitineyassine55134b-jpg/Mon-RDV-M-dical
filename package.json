{
  "name": "mon-rdv-medical",
  "version": "1.0.0",
  "private": true,
  "description": "Mon RDV Médical - application Android (Capacitor)",
  "scripts": {
    "prepare-www": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');['index.html','manifest.webmanifest','sw.js'].forEach(f=>fs.copyFileSync(f,'www/'+f));fs.cpSync('assets','www/assets',{recursive:true})\"",
    "android:add": "npm run prepare-www && npx cap add android",
    "android:sync": "npm run prepare-www && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
